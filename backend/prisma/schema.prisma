datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model EscrowDeal {
  dealId           String   @id
  buyerAddress     String?
  sellerAddress    String?
  criteriaText     String?
  deliverableText  String?
  taskCategory     String?
  deadline         DateTime?
  state            String?
  aiVerdict        Boolean?
  aiReasoning      String?
  aiScore          Float?
  verdictHash      String?
  resolvedTxHash   String?
  evaluationPrompt String?
  modelId          String?
  modelVersion     String?
  rawLlmResponse   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
