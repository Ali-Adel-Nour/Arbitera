ARBITRA_BACKEND_URL=http://localhost:3000

# ── The Graph (required for Graph AI tools) ──────────────────────────────
# Gateway API key from https://thegraph.com/studio/ — queries 15K+ live subgraphs
GRAPH_API_KEY=

# Optional: Direct endpoint for a self-hosted Arbitra subgraph (e.g., Arc Testnet)
GRAPH_ENDPOINT=

# ── LLM (required for AI reasoning tools) ────────────────────────────────
# Uses OpenAI-compatible chat completions API (Gemini, OpenAI, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
